{
  "name": "@dwelling/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint . --ext .js,.ts",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"eslint.config.js\" \"vitest.config.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"eslint.config.js\" \"vitest.config.js\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@dwelling/shared": "*",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "redis": "^4.7.0",
    "socket.io": "^4.8.1"
  }
}