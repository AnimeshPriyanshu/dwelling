# .env.example
# Copy this file to the repository root as `.env`:
#   cp backend/.env.example .env
# The backend loads the root `.env`; `.env` itself is gitignored.
#
# Port for the server (default 3000)
PORT=3000
# Client origin for CORS
CLIENT_ORIGIN=http://localhost:5173
# JWT secret for signing tokens (required). Generate your own, e.g.
#   openssl rand -base64 32
# Never commit a real secret; this file is tracked.
JWT_SECRET=replace-me
# PostgreSQL connection used by Prisma (optional until database work starts)
DATABASE_URL="postgresql://animeshpriyanshu:password@localhost:5432/dwelling?schema=public"
# Redis is optional; leave unset to run without caching
# REDIS_URL=redis://localhost:6379

